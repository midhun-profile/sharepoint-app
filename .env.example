# ==============================================================================
# ENTERPRISE SHAREPOINT MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# ⚠️ SECURITY WARNING:
# THIS IS A CLIENT-SIDE SINGLE PAGE APPLICATION (SPA).
# NEVER STORE CLIENT SECRETS, PRIVATE KEYS, OR USER PASSWORDS IN THIS FILE
# OR ANY CLIENT-SIDE CODE. ALL VALUES IN VITE_ PREFIXED VARIABLES ARE PUBLICLY
# EXPOSED TO THE BROWSER DOM AND NETWORK TAB.
# ==============================================================================

# Microsoft Entra ID (Azure AD) Client Authentication Setup
# App Registration -> Overview -> Application (client) ID
VITE_ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Microsoft Entra ID Tenant ID or "common" / "organizations"
VITE_ENTRA_TENANT_ID="common"

# Redirect URI configured in Entra ID App Registration
VITE_ENTRA_REDIRECT_URI="http://localhost:3000"

# Target SharePoint Online Site ID (Graph API Format: domain.sharepoint.com,site-id,web-id)
VITE_SHAREPOINT_SITE_ID="contoso.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000"

# Engine Mode: Set to "true" for local interactive demo mode without needing immediate Azure Tenant credentials,
# or "false" to authenticate live via Microsoft Entra ID + Graph API.
VITE_ENABLE_MOCK_ENGINE="true"
